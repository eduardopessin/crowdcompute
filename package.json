{
  "name": "crowdcompute",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "build": "astro build",
    "preview": "wrangler pages dev dist --port 8788",
    "dev:full": "npm run build && npm run db:migrate:local && npm run preview",
    "typecheck": "astro check && tsc --noEmit -p tsconfig.functions.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check": "npm run lint && npm run typecheck && npm test && npm run build",
    "db:migrate:local": "wrangler d1 migrations apply crowdcompute --local",
    "db:migrate:remote": "wrangler d1 migrations apply crowdcompute --remote",
    "deploy": "node scripts/check-deploy.mjs && npm run check && wrangler pages deploy dist --project-name crowdcompute --branch main",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "astro": "^7.3.2"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@axe-core/playwright": "^4.13.0",
    "@cloudflare/workers-types": "^5.20260911.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "eslint": "^10.10.0",
    "eslint-plugin-astro": "^3.1.0",
    "miniflare": "^4.20260730.0",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^1.0.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.0",
    "wrangler": "^4.131.1"
  },
  "overrides": {
    "undici": "^7.29.0",
    "sharp": "^0.35.4"
  }
}
