{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022"],
    "types": ["@cloudflare/workers-types"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true
  },
  "include": [
    "functions/**/*.ts",
    "src/lib/validation.ts",
    "src/lib/countries.ts",
    "src/lib/stats.ts"
  ]
}
